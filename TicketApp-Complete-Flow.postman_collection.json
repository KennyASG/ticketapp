  "item": [
    {
      "name": "1. AUTH SERVICE (Puerto 3001)",
      "item": [
        {
          "name": "1.1 Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.environment.set('user_id', jsonData.id);",
                  "        console.log('✅ User ID guardado:', jsonData.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Test\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"role_id\": 2\n}"
            },
            "url": {
              "raw": "{{auth_service}}/auth/register",
              "host": ["{{auth_service}}"],
              "path": ["auth", "register"]
            },
            "description": "Registra un nuevo usuario en el sistema"
          },
          "response": []
        },
        {
          "name": "1.2 Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set('auth_token', jsonData.token);",
                  "        console.log('🔐 Token guardado exitosamente');",
                  "    }",
                  "    if (jsonData.user && jsonData.user.id) {",
                  "        pm.environment.set('user_id', jsonData.user.id);",
                  "        console.log('👤 User ID:', jsonData.user.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{auth_service}}/auth/login",
              "host": ["{{auth_service}}"],
              "path": ["auth", "login"]
            },
            "description": "⭐ EMPEZAR AQUÍ - Login como administrador. El token se guarda automáticamente."
          },
          "response": []
        },
        {
          "name": "1.3 Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_service}}/auth/admin/users",
              "host": ["{{auth_service}}"],
              "path": ["auth", "admin", "users"]
            },
            "description": "Lista todos los usuarios del sistema (solo administradores)"
          },
          "response": []
        }
      ],
      "description": "Endpoints de autenticación y gestión de usuarios"
    },
