                  "    pm.test('✅ Reserva creada exitosamente', () => {",
                  "        pm.expect(jsonData).to.have.property('reservation_id');",
                  "        pm.expect(jsonData).to.have.property('expires_at');",
                  "    });",
                  "    ",
                  "    pm.test('✅ Tiempo de expiración es válido', () => {",
                  "        const expiresAt = new Date(jsonData.expires_at);",
                  "        const now = new Date();",
                  "        const diffMinutes = (expiresAt - now) / (1000 * 60);",
                  "        // La reserva debe expirar en aproximadamente 5 minutos (RabbitMQ)",
                  "        pm.expect(diffMinutes).to.be.within(4, 6);",
                  "    });",
                  "    ",
                  "    pm.environment.set('reservation_id', jsonData.reservation_id);",
                  "    console.log('📝 Reservation ID guardado:', jsonData.reservation_id);",
                  "    console.log('⏰ Expira en:', jsonData.expires_at);",
                  "    ",
                  "    if (jsonData.seats) {",
                  "        console.log('💺 Asientos reservados:', jsonData.seats.length);",
                  "    }",
                  "}"
