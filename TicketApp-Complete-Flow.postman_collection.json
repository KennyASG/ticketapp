    {
      "name": "6. ÓRDENES",
      "item": [
        {
          "name": "6.1 Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('order_id', jsonData.order.id);",
                  "    pm.test('Orden creada correctamente', function () {",
                  "        pm.expect(jsonData.order).to.have.property('id');",
                  "        pm.expect(jsonData).to.have.property('total');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservation_id\": {{reservation_id}},\n  \"ticket_type_id\": {{ticket_type_id}},\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url_order}}/orders",
              "host": ["{{base_url_order}}"],
              "path": ["orders"]
            }
          },
          "response": []
        },
        {
          "name": "6.2 Confirm Order (Payment)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Orden confirmada correctamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.order).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('tickets');",
                  "    pm.expect(jsonData.tickets.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url_order}}/orders/{{order_id}}/confirm",
              "host": ["{{base_url_order}}"],
              "path": ["orders", "{{order_id}}", "confirm"]
            }
          },
