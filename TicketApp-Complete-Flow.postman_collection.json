{
  "info": {
    "name": "TicketApp - Sistema de Reserva de Conciertos",
    "description": "Colección completa de APIs para aplicación de microservicios de reserva de tickets con Redis y RabbitMQ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Script global para verificar token antes de cada request",
          "if (!pm.environment.get('auth_token') && !pm.request.url.path.includes('login') && !pm.request.url.path.includes('register')) {",
          "    console.warn('⚠️ No hay token de autenticación. Por favor ejecuta Login primero.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test global para validar respuestas",
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "    pm.test('✅ Status code es exitoso', () => {",
          "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "    });",
          "}",
          "",
          "pm.test('✅ Response es JSON válido', () => {",
          "    pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "concert_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "venue_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "section_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticket_type_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    }
  ],
